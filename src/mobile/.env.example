# Copy to .env (never commit .env) and fill in for your setup.
# Expo inlines EXPO_PUBLIC_* variables into the app bundle, so never put secrets here.

# Base URL of the Sehati backend (Hono on Cloudflare Workers), without a trailing slash.
# - iPhone / Android phone with Expo Go: your PC's LAN IP, e.g. http://192.168.1.10:8787
# - Android emulator:                    http://10.0.2.2:8787
# - Web / iOS simulator on the same PC:  http://localhost:8787
# - Deployed Worker:                     https://<worker-name>.<subdomain>.workers.dev
EXPO_PUBLIC_API_URL=http://localhost:8787

# Demo login for assistants (issue #3): shows "Mode demo" buttons on the login
# screen that sign in as the seeded Mahasiswa / Administrator. 1 = on, anything else = off.
EXPO_PUBLIC_MODE_DEMO=1
