{
	"main": "src/index.ts",
  "name": "sehati-backend",
  "compatibility_date": "2026-11-04",
    "d1_databases": [
    {
      "binding": "D1",
      "database_name": "sehati-db",
      "database_id": "2061ca01-6f0f-4e31-a2e7-5da3889d89ec",
      "migrations_dir": "migrations",
    }
  ],
  // Three schedules: notification dispatch every minute (Algo-005 / Algo-007),
  // status probes every 5 minutes (Algo-021), and database cleanup twice a day.
  "triggers": {
    "crons": [
      // for affirmations and reminders
      "* * * * *",
      // status check
      "*/5 * * * *",
      // db cleanup
      "0 */12 * * *"
    ]
  },
  "observability": {
    "issues": {
      "enabled": true
    },
    "logs": {
      "enabled": true
    },
    "traces": {
      "enabled": true
    }
  },
  "vars": {
    "API_BASE_URL": "https://sehati.sbxte.net",
    "GOOGLE_REDIRECT_URI": "https://sehati.sbxte.net/api/auth/google/callback"
  },
}
